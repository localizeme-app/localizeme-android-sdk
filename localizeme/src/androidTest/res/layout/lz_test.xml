<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/lz_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:subtitle="@string/lz_test_subtitle"
        app:title="@string/lz_test_toolbar" />

    <TextView
        android:id="@+id/lz_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/lz_test_description"
        android:text="@string/lz_test_title" />

    <EditText
        android:id="@+id/lz_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/lz_test_hint"
        android:importantForAutofill="no"
        android:inputType="text" />

    <TextView
        android:id="@+id/lz_bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lz_test_bold" />

    <TextView
        android:id="@+id/lz_literal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="A literal stays" />

</LinearLayout>
